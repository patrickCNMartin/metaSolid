# Selective Git
*
!.gitignore

# Whitelist directories
!.github/
!tests/
!src/
!ollama-models/
!env/
!security/

# Whitelist Assets #
# README
!README.md
# Security files
!security/.secrets.baseline
# Pre-commit config/ pre-push
!.pre-commit-config.yaml
# Adding example env
!env/.env.example
## Nix Files ##
!flake.lock
!flake.nix
## Uv files
!pyproject.toml
!uv.lock
## Source code ##
!src/*.py
## Testing ##
!tests/*.py
## Modelfiles ##
!ollama/*.modelfile
# GitHub Actions
!.github/*.yaml
