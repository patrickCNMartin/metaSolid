# ==========================================
# IGNORE EVERTHING
# ==========================================
*

# ==========================================
# TOP LEVEL DIRECTORIES
# ==========================================
!.github/
!.github/workflows/
!tests/
!src/
!ollama-models/
!env/
!security/

# ==========================================
# GLOBAL BLACKLISTS 
# ==========================================
**/__pycache__/
**/*.pyc
ollama-models/logs/
src/*.egg-info/

# ==========================================
# WHITELISTED ASSETS & CONFIGS
# ==========================================
!.gitignore
!README.md
!.pre-commit-config.yaml
!security/.secrets.baseline

# Environments
!env/.env.example

# Nix & Package Management
!flake.lock
!flake.nix
!pyproject.toml
!uv.lock

# ==========================================
# RECURSIVE SOURCE CODE & ASSETS WHITELIST
# ==========================================

!src/**/*.py
#!src/**/*.ipynb

## Testing
!tests/**/*.py

## Modelfiles
!ollama-models/**/*.modelfile

## GitHub Actions
!.github/workflows/**/*.yaml
!.github/workflows/**/*.yml