# ==========================================
# 1. THE DEFAULT BLANKET IGNORE
# ==========================================
# Ignore everything at every level by default
*

# ==========================================
# 2. OPEN THE TOP-LEVEL DOORS (Directories)
# ==========================================
# We must explicitly tell Git it's allowed to step into these folders
!.github/
!.github/workflows/
!tests/
!src/
!ollama-models/
!env/
!security/

# ==========================================
# GLOBAL BLACKLISTS 
# ==========================================
# Even inside un-ignored folders, explicitly block python cache and logs
**/__pycache__/
**/*.pyc
ollama-models/logs/
src/*.egg-info/

# ==========================================
# WHITELISTED ASSETS & CONFIGS
# ==========================================
!.gitignore
!README.md
!.pre-commit-config.yaml
!security/.secrets.baseline

# Environments
!env/.env.example

# Nix & Package Management
!flake.lock
!flake.nix
!pyproject.toml
!uv.lock

# ==========================================
# RECURSIVE SOURCE CODE & ASSETS WHITELIST
# ==========================================

!src/**/*.py
#!src/**/*.ipynb

## Testing
!tests/**/*.py

## Modelfiles
!ollama-models/**/*.modelfile

## GitHub Actions
!.github/workflows/**/*.yaml
!.github/workflows/**/*.yml