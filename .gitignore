# Selective Git
*
!*/
!.gitignore
!.pre-commit-config.yaml
!.secrets.baseline

# Black List - Make sure that variation on .env will be excluded no matter what 
.env
.env.*
security/.env
security/.env.*
env/.env
env/.env.*
.venv/

# Whitelisted Assets #
## Nix Files ##
!flake.lock
!flake.nix
## Uv files
!pyproject.toml
!uv.lock
## Python ##
!*.py

## Modelfiles ##
!*.modelfile
