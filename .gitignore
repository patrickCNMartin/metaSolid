# metaSolid: a denylist. New files are tracked unless a rule below says otherwise.
# Leaked credentials are caught by detect-secrets, not by this file.

# --- Secrets -----------------------------------------------------------------
.env
.env.*
*.env
!env/.env.example

# --- Data and local tooling --------------------------------------------------
data/
# iLab tooling and its synthetic data stay local, never committed.
iLab/
*.log

# --- Agent -------------------------------------------------------------------
.claude/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- Environments ------------------------------------------------------------
.pixi/
result
result-*

# --- Notebooks ---------------------------------------------------------------
*.ipynb
.ipynb_checkpoints/

# --- OS and editors ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
