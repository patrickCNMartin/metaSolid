# Copy to env/.env. Providers: ollama, llama-cpp, vllm, open-llm, openai.
# An empty *_ENDPOINT uses the provider's default; *_API_KEY is only sent when set.

# Embedding: turns each field and its meaning into a vector.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_ENDPOINT=http://localhost:11434/v1/embeddings
EMBED_API_KEY=

# Generation: names the clusters and writes the hierarchy.
# The models are created from ollama-models/ (README, "Creating the models").
GEN_PROVIDER=ollama
GEN_MODEL=qwen:2.5_7B
# GEN_MODEL=gemma:4_12B
GEN_ENDPOINT=http://localhost:11434/v1/chat/completions
GEN_API_KEY=

# Clustering cut-off (cosine distance), also the match cut-off in harmonize_to_target
# (cosine similarity).
SEMANTIC_THRESHOLD=0.2
# Fields whose context is at least this similar to an exclusion term are dropped.
SEMANTIC_EXCLUSION=0.5
SEMANTIC_EXCLUSION_TERMS=["API", "url", "HTTP", "git"]
