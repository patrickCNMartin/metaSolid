#=============================================================================#
# ILAB PARAMS
#=============================================================================#
# iLAB API Key
ILAB_KEY=
# Domain locations
ILAB_DOMAIN=https://api-eu.ilabsolutions.com
DEFAULT_CORE_LOCATION=v1/cores

# CORE INFO if known
CORE_ID=
CORE_NAME=

# OPTIONAL PARAMS
# This is going to be a pain to handle. 
# The issue is that iLab reuses status tags 
# We will have to come up with custom local filters since there are 
# not that many API filter that exist. 
# ATM using json but it might be a good idea to use a local sql cache
TO_DATE="today" # Only option implemented
FROM_DATE="2years" # time from today (number of days/weeks/months/years)
REQUEST_TYPE = ["new", "assigned"] # could be updated to use AND OR NOR XOR
FILTER_CRITERIA={}

#=============================================================================#
# LLM PARAMS
#=============================================================================#
GEN_PROVIDER="ollama"
GEN_MODEL="qwen:v0.0.1"
GEN_ENDPOINT="http://localhost:11434/v1/chat/completions"
GEN_API_KEY=

EMBED_MODEL="nomic-embed-text"
EMBED_ENDPOINT="http://localhost:11434/v1/embeddings"
EMBED_API_KEY=

SEMANTIC_THRESHOLD=0.2
SEMANTIC_EXCLUSION_TERMS=['API','url','HTTP','git']